generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROCUREMENT_OFFICER
  MANAGER
  VIEWER
}

enum VatStatusType {
  APPLICABLE
  EXEMPT
}

enum VatBasis {
  INCLUSIVE
  EXCLUSIVE
}

enum LpoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum DeliveryStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum CreditNoteStatus {
  PENDING
  REQUESTED
  RECEIVED
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         UserRole  @default(PROCUREMENT_OFFICER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  preparedLpos LPO[]     @relation("PreparedBy")
  approvedLpos LPO[]     @relation("ApprovedBy")
  sessions     Session[]
}

model Session {
  id        String   @id // opaque random token, doubles as the cookie value
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Supplier {
  id            String            @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  String?
  taxPin        String?
  bankDetails   String?
  notes         String?
  active        Boolean           @default(true)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  products      SupplierProduct[]
  lpos          LPO[]
}

model Product {
  id        String            @id @default(cuid())
  name      String
  categoryId String
  category  Category          @relation(fields: [categoryId], references: [id])
  unit      String
  vatStatus VatStatusType     @default(APPLICABLE)
  vatRate   Decimal           @default(16) @db.Decimal(5, 2)
  notes     String?
  active    Boolean           @default(true)
  deletedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  suppliers SupplierProduct[]
  lpoItems  LPOItem[]

  @@index([categoryId])
}

model SupplierProduct {
  id          String         @id @default(cuid())
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  isPreferred Boolean        @default(false)
  notes       String?
  createdAt   DateTime       @default(now())
  priceHistory PriceHistory[]

  @@unique([supplierId, productId])
}

// Append-only: a new price is always inserted, never edited or deleted.
model PriceHistory {
  id                String          @id @default(cuid())
  supplierProductId String
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id])
  vatBasis          VatBasis
  quotedPrice       Decimal         @db.Decimal(12, 2)
  vatRate           Decimal         @db.Decimal(5, 2)
  priceExclVat      Decimal         @db.Decimal(12, 2)
  vatAmount         Decimal         @db.Decimal(12, 2)
  priceInclVat      Decimal         @db.Decimal(12, 2)
  effectiveDate     DateTime
  sourceReference   String?
  notes             String?
  createdAt         DateTime        @default(now())
  lpoItems          LPOItem[]

  @@index([supplierProductId, effectiveDate])
}

model LPO {
  id           String     @id @default(cuid())
  lpoNumber    String     @unique
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  status       LpoStatus  @default(DRAFT)
  orderDate    DateTime   @default(now())
  preparedById String?
  preparedBy   User?      @relation("PreparedBy", fields: [preparedById], references: [id])
  approvedById String?
  approvedBy   User?      @relation("ApprovedBy", fields: [approvedById], references: [id])
  subtotal     Decimal    @db.Decimal(12, 2)
  vatTotal     Decimal    @db.Decimal(12, 2)
  grandTotal   Decimal    @db.Decimal(12, 2)
  notes        String?
  terms        String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        LPOItem[]
  deliveries   Delivery[]
}

model LPOItem {
  id             String         @id @default(cuid())
  lpoId          String
  lpo            LPO            @relation(fields: [lpoId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  priceHistoryId String?
  priceHistory   PriceHistory?  @relation(fields: [priceHistoryId], references: [id])
  quantity       Decimal        @db.Decimal(12, 2)
  unit           String
  unitPrice      Decimal        @db.Decimal(12, 2)
  vatStatus      VatStatusType
  vatRate        Decimal        @db.Decimal(5, 2)
  lineSubtotal   Decimal        @db.Decimal(12, 2)
  lineVat        Decimal        @db.Decimal(12, 2)
  lineTotal      Decimal        @db.Decimal(12, 2)
  deliveryItems  DeliveryItem[]
}

model Delivery {
  id           String         @id @default(cuid())
  lpoId        String
  lpo          LPO            @relation(fields: [lpoId], references: [id])
  deliveryDate DateTime       @default(now())
  status       DeliveryStatus @default(NOT_RECEIVED)
  notes        String?
  createdAt    DateTime       @default(now())
  items        DeliveryItem[]
}

model DeliveryItem {
  id           String       @id @default(cuid())
  deliveryId   String
  delivery     Delivery     @relation(fields: [deliveryId], references: [id])
  lpoItemId    String
  lpoItem      LPOItem      @relation(fields: [lpoItemId], references: [id])
  orderedQty   Decimal      @db.Decimal(12, 2)
  deliveredQty Decimal      @db.Decimal(12, 2)
  notes        String?
  creditNotes  CreditNote[]
}

model CreditNote {
  id               String           @id @default(cuid())
  deliveryItemId   String
  deliveryItem     DeliveryItem     @relation(fields: [deliveryItemId], references: [id])
  creditNoteNumber String?
  creditNoteDate   DateTime?
  amount           Decimal          @db.Decimal(12, 2)
  status           CreditNoteStatus @default(PENDING)
  notes            String?
  createdAt        DateTime         @default(now())
}

// Singleton — always the single row with id "singleton".
model Settings {
  id              String   @id @default("singleton")
  companyName     String   @default("Your Restaurant Name")
  companyAddress  String?
  companyPhone    String?
  companyEmail    String?
  defaultVatRate  Decimal  @default(16) @db.Decimal(5, 2)
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  summary   String
  actor     String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
